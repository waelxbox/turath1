NODE_ENV=production
PORT=3000

# Use the pooled PostgreSQL application connection string.
DATABASE_URL=postgresql://user:password@host:6543/database?sslmode=require&pgbouncer=true

# Generate independently for staging: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=https://staging.turath.example
TRUST_PROXY_HOPS=1

GOOGLE_CLIENT_ID=replace-with-staging-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-staging-oauth-client-secret

BUILT_IN_FORGE_API_URL=https://replace-with-forge-api.example/
BUILT_IN_FORGE_API_KEY=replace-with-staging-forge-key
GOOGLE_AI_API_KEY=replace-with-staging-google-ai-key

# Keep pricing disabled until webhook verification and staging products are tested.
TURATH_PRICING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_with_staging_pro
STRIPE_TEAM_PRICE_ID=price_replace_with_staging_team
PUBLIC_APP_URL=https://staging.turath.example

VITE_APP_ID=turath-staging
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
