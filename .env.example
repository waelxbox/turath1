# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (required)
# Use a dedicated database for local/staging. The database user must be able to
# create the `vector` extension, or an administrator must enable it beforehand.
# Supabase transaction-pooler URLs should include `?pgbouncer=true`.
DATABASE_URL=postgresql://turath_app:replace-me@localhost:5432/turath_staging

# Authentication (required outside local-only development)
# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI providers
# Direct Gemini access is optional when the Forge fallback is configured.
GOOGLE_AI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Frontend map/Forge integration. VITE_ values are embedded in the client
# bundle and must never contain credentials that are intended to stay secret.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Leave both empty to disable the injected script.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Billing (optional in controlled staging)
TURATH_PRICING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
PUBLIC_APP_URL=https://staging.turath.example
